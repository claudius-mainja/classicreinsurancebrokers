---
import AppLayout from '../components/layouts/AppLayout.astro';
import ParticleBg from '../components/react/ParticleBg.tsx';
---

<AppLayout
  title="Page Not Found"
  description="Page not found — Classic Reinsurance Brokers. The page you are looking for does not exist or has been moved."
  robots="noindex, follow"
>
  <section class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center overflow-hidden py-20">
    <ParticleBg />
    <div class="relative mx-auto max-w-7xl px-6 text-center">
      <div class="mx-auto max-w-lg">
        <span class="inline-block text-[120px] font-black leading-none text-primary-500/20 font-sora">404</span>
        <h1 class="mt-[-10px] text-4xl font-bold text-white sm:text-5xl font-sora">Page Not Found</h1>
        <p class="mt-6 text-lg text-neutral-400">
          The page you are looking for does not exist or has been moved. Let us help you find what you need.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a href="/" class="btn btn-primary">Back to Home</a>
          <a href="/services" class="btn btn-dark">Our Services</a>
          <a href="/contact" class="btn btn-dark">Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</AppLayout>
