---
import AppLayout from '../../components/layouts/AppLayout.astro';
import Breadcrumb from '../../components/astro/Breadcrumb.astro';
import ParticleBg from '../../components/react/ParticleBg.tsx';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
---

<AppLayout
  title="Reinsurance Insights"
  description="Expert insights, analysis, and thought leadership on reinsurance, risk management, and the Zimbabwean insurance market from Classic Reinsurance Brokers."
  keywords="reinsurance insights, reinsurance blog Zimbabwe, risk management insights, insurance market analysis, Classic Reinsurance Brokers blog"
  ogTitle="Reinsurance Insights | Classic Reinsurance Brokers Blog"
  ogDescription="Expert reinsurance insights, market analysis, and thought leadership from Zimbabwe's premier reinsurance broker."
  canonical="https://www.classicre.co.zw/blog"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Insights' }]} />

  <section class="relative min-h-[50vh] flex items-center overflow-hidden bg-neutral-950">
    <div class="absolute inset-0">
      <img src="/images/herobg.png" alt="" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-br from-primary-900/80 via-neutral-950/85 to-neutral-950"></div>
    </div>
    <ParticleBg />
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl stagger-fade">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold text-primary-300">Our insights</span>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">Reinsurance Insights</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-300">Expert analysis, market intelligence, and thought leadership on reinsurance, risk management, and the Zimbabwean insurance landscape.</p>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-4">
        <div class="lg:col-span-4">
          {sorted.length > 0 ? (
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 stagger-fade">
              {sorted.map((post) => (
                <article class="rounded-xl border border-white/10 bg-white/5 overflow-hidden transition-all duration-300 hover:border-primary-500/30 hover:-translate-y-2 hover:shadow-xl hover:shadow-primary-500/5 group">
                  <a href={`/blog/${post.slug}`} class="block">
                    <div class="aspect-[16/9] overflow-hidden bg-neutral-800">
                      <img src={post.data.featuredImage || '/images/blog-placeholder.jpg'} alt={post.data.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
                    </div>
                  </a>
                  <div class="p-6">
                    <div class="mb-3 flex flex-wrap items-center gap-2">
                      <span class="rounded-full bg-primary-500/20 px-3 py-0.5 text-xs font-medium text-primary-300">{post.data.category || 'Insurance'}</span>
                      <span class="text-xs text-neutral-500">{new Date(post.data.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                    </div>
                    <h2 class="text-lg font-bold text-white transition-colors group-hover:text-primary-400"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-400 line-clamp-3">{post.data.excerpt}</p>
                    <div class="mt-4 flex items-center justify-between border-t border-white/10 pt-4">
                      <div class="flex items-center gap-3">
                        <img src={post.data.authorAvatar || '/images/team-placeholder.jpg'} alt={post.data.author} class="h-7 w-7 rounded-full object-cover" />
                        <span class="text-sm font-medium text-neutral-300">{post.data.author}</span>
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="py-20 text-center">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-neutral-800">
                <svg class="h-8 w-8 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
              </div>
              <h3 class="mt-4 text-xl font-bold text-white">No articles yet</h3>
              <p class="mt-2 text-neutral-400">Check back soon for our latest insights and analysis.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</AppLayout>
