---
import AppLayout from '../components/layouts/AppLayout.astro';
import Breadcrumb from '../components/astro/Breadcrumb.astro';
import { site } from '../data/site';
---

<AppLayout
  title="Careers"
  description="Join the Classic Reinsurance Brokers team. Explore career opportunities with Zimbabwe's premier reinsurance broker. Careers in reinsurance, insurance broking, and advisory in Harare, Zimbabwe."
  keywords="careers Classic Reinsurance Brokers, reinsurance jobs Zimbabwe, insurance careers Harare, reinsurance broker jobs, broking companies Zimbabwe careers, insurance jobs Zimbabwe"
  ogTitle="Careers at Classic Reinsurance Brokers"
  ogDescription="Join Zimbabwe's premier reinsurance broker. Explore career opportunities in reinsurance broking, advisory, and operations in Harare."
  canonical="https://www.classicre.co.zw/careers"
  breadcrumbJsonLd={`{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.classicre.co.zw" },
      { "@type": "ListItem", "position": 2, "name": "Careers", "item": "https://www.classicre.co.zw/careers" }
    ]
  }`}
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Careers' }]} />

  <section class="relative min-h-[55vh] flex items-center overflow-hidden bg-neutral-950">
    <div class="absolute inset-0">
      <img src="/images/herobg.png" alt="" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-br from-primary-900/80 via-neutral-950/85 to-neutral-950"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8 py-24 lg:py-32 w-full">
      <div class="max-w-3xl stagger-fade">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold text-primary-200">Join our team</span>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">Careers at <span class="text-primary-400">Classic Re</span></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-300">Build your career with Zimbabwe's premier reinsurance broker. We are always looking for talented individuals passionate about insurance and reinsurance.</p>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center stagger-fade">
      <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">Open Positions</span>
      <h2 class="mt-6 text-3xl font-bold tracking-tight text-white sm:text-4xl font-sora">No Openings at This Time</h2>
      <p class="mt-4 text-lg leading-relaxed text-neutral-400">We currently do not have any open positions. However, we are always interested in connecting with talented professionals. Send your CV to <a href="mailto:{site.email}" class="text-primary-400 hover:text-primary-300 transition-colors">{site.email}</a> and we will keep you in mind for future opportunities.</p>
      <div class="mt-10">
        <a href="mailto:{site.email}" class="btn btn-primary text-base px-8 py-3">
          Send your CV
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-3 stagger-fade">
        <div class="rounded-xl border border-white/10 bg-white/5 p-8 text-center transition-all duration-300 hover:border-primary-500/30 hover:-translate-y-1">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-primary-600/20 text-primary-400">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3"/></svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Industry Expertise</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-400">Join a team with deep knowledge of the Zimbabwean and African insurance markets.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-8 text-center transition-all duration-300 hover:border-primary-500/30 hover:-translate-y-1">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-primary-600/20 text-primary-400">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"/></svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Professional Growth</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-400">Continuous learning and development opportunities in a dynamic industry.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-8 text-center transition-all duration-300 hover:border-primary-500/30 hover:-translate-y-1">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-primary-600/20 text-primary-400">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772"/></svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Great Culture</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-400">Collaborative environment where your contributions are valued and recognised.</p>
        </div>
      </div>
    </div>
  </section>
</AppLayout>
