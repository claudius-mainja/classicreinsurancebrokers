---
import AppLayout from '../components/layouts/AppLayout.astro';
import Breadcrumb from '../components/astro/Breadcrumb.astro';
import AnimatedSection from '../components/react/AnimatedSection.tsx';
import { site } from '../data/site';
---

<AppLayout
  title="Contact Us"
  description="Get in touch with Classic Reinsurance Brokers — Zimbabwe's premier reinsurance broker. Call +263 242 773192 or email info@classicre.co.zw. 11th Floor Fidelity Life Tower, 5 Raleigh Street, Harare. Serving insurance companies across Zimbabwe."
  keywords="contact Classic Reinsurance Brokers, reinsurance broker Harare contact, reinsurance broker Zimbabwe phone, email, address, reinsurance companies Zimbabwe, broking companies Zimbabwe, insurance broker Harare, reinsurance broker Bulawayo, insurance companies Zimbabwe contact"
  ogTitle="Contact Classic Reinsurance Brokers — Zimbabwe's Reinsurance Broker"
  ogDescription="Contact Zimbabwe's premier reinsurance broker. Call +263 242 773192, email info@classicre.co.zw, or visit our Harare office at 11th Floor Fidelity Life Tower."
  canonical="https://www.classicre.co.zw/contact"
  breadcrumbJsonLd={`{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.classicre.co.zw" },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.classicre.co.zw/contact" }
    ]
  }`}
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />

  <section class="relative min-h-[55vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/HomeContact.png" alt="" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-br from-primary-900/80 via-neutral-950/85 to-neutral-950"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8 py-24 lg:py-32 w-full">
      <div class="max-w-3xl stagger-fade">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold text-primary-200">Contact Us</span>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">Get in <span class="text-primary-400">Touch</span></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-300">Whether you need a reinsurance placement, market information, or simply want to explore how we can support your insurance portfolio — we are here to help.</p>
      </div>
    </div>
  </section>

  <AnimatedSection animation="fade-up">
    <section class="relative -mt-20 pb-20 lg:-mt-28 lg:pb-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-3">
          <div class="space-y-6 lg:col-span-1 stagger-fade">
            <div class="rounded-xl border border-white/10 bg-white/5 p-6 transition-all duration-300 hover:border-primary-500/30 hover:-translate-y-1 hover:shadow-lg hover:shadow-primary-500/5">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500/10">
                <svg class="h-5 w-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">Phone</h3>
              {site.phones.map((phone) => (
                <a key={phone} href="tel:{site.phoneRaw.replace(/[^0-9]/g, '')}" class="mt-2 block text-sm text-neutral-400 transition-colors hover:text-primary-400">{phone}</a>
              ))}
            </div>

            <div class="rounded-xl border border-white/10 bg-white/5 p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500/10">
                <svg class="h-5 w-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">Email</h3>
              <a href="mailto:{site.email}" class="mt-2 block text-sm text-neutral-400 transition-colors hover:text-primary-400">{site.email}</a>
              <p class="mt-1 text-xs text-neutral-600">We respond within 24 hours</p>
            </div>

            <div class="rounded-xl border border-white/10 bg-white/5 p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500/10">
                <svg class="h-5 w-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">Address</h3>
              <p class="mt-2 text-sm text-neutral-400">
                {site.address.street}<br />
                {site.address.street2}<br />
                {site.address.city}, {site.address.country}
              </p>
            </div>

            <div class="rounded-xl border border-white/10 bg-white/5 p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500/10">
                <svg class="h-5 w-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">Office Hours</h3>
              <p class="mt-2 text-sm text-neutral-400">{site.hours}</p>
              <p class="mt-1 text-xs text-neutral-600">Closed weekends & public holidays</p>
            </div>

            <div class="rounded-xl border border-white/10 bg-white/5 p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500/10">
                <svg class="h-5 w-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7v-.394c0-1.08-.434-2.116-1.206-2.88A4.09 4.09 0 0014.876 2.5h-3.752a4.09 4.09 0 00-2.918 1.226A4.109 4.109 0 007 6.606V7m12 0v11.394a4.11 4.11 0 01-1.206 2.88A4.09 4.09 0 0114.876 22.5h-3.752a4.09 4.09 0 01-2.918-1.226A4.11 4.11 0 007 18.394V7m12 0H7"/></svg>
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">Company Profile</h3>
              <a href={site.companyProfile} target="_blank" class="mt-2 inline-flex items-center gap-1 text-sm text-primary-400 transition-colors hover:text-primary-300">
                Download PDF &rarr;
              </a>
            </div>
          </div>

          <div class="lg:col-span-2">
            <div class="rounded-xl border border-white/10 bg-white/5 p-8">
              <h2 class="text-xl font-semibold text-white font-sora">Send Us a Message</h2>
              <p class="mt-2 text-sm text-neutral-500">Fill in the form and we will get back to you within 24 hours. Alternatively, email us directly at <a href="mailto:{site.email}" class="text-primary-400 hover:text-primary-300">{site.email}</a>.</p>
              <form action="mailto:info@classicre.co.zw" method="post" enctype="text/plain" class="mt-8 space-y-6">
                <div class="grid gap-6 sm:grid-cols-2">
                  <div>
                    <label for="name" class="block text-sm font-medium text-neutral-300">Full Name *</label>
                    <input type="text" name="name" id="name" required class="mt-1.5 block w-full rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-neutral-600 outline-none transition-colors focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/20" placeholder="John Smith" />
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-medium text-neutral-300">Email Address *</label>
                    <input type="email" name="email" id="email" required class="mt-1.5 block w-full rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-neutral-600 outline-none transition-colors focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/20" placeholder="john@insurance.co.zw" />
                  </div>
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-neutral-300">Company Name</label>
                  <input type="text" name="company" id="company" class="mt-1.5 block w-full rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-neutral-600 outline-none transition-colors focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/20" placeholder="Your Insurance Company" />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-neutral-300">Phone Number</label>
                  <input type="tel" name="phone" id="phone" class="mt-1.5 block w-full rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-neutral-600 outline-none transition-colors focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/20" placeholder="+263 77 123 4567" />
                </div>
                <div>
                  <label for="subject" class="block text-sm font-medium text-neutral-300">Subject *</label>
                  <select name="subject" id="subject" required class="mt-1.5 block w-full rounded-lg border border-white/10 bg-neutral-900 px-4 py-2.5 text-sm text-white outline-none transition-colors focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/20">
                    <option value="" class="text-neutral-600">Select a subject</option>
                    <option value="Treaty Reinsurance Enquiry">Treaty Reinsurance Enquiry</option>
                    <option value="Facultative Reinsurance Enquiry">Facultative Reinsurance Enquiry</option>
                    <option value="Advisory Services">Advisory Services</option>
                    <option value="Partnership Opportunity">Partnership Opportunity</option>
                    <option value="General Enquiry">General Enquiry</option>
                  </select>
                </div>
                <div>
                  <label for="message" class="block text-sm font-medium text-neutral-300">Message *</label>
                  <textarea name="message" id="message" rows="5" required class="mt-1.5 block w-full rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-neutral-600 outline-none transition-colors focus:border-primary-500/50 focus:ring-1 focus:ring-primary-500/20 resize-y" placeholder="Tell us about your reinsurance needs..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-full sm:w-auto">Send Message</button>
                <p class="text-xs text-neutral-600">By submitting this form, you agree to our <a href="/privacy-policy" class="text-primary-400 hover:text-primary-300">Privacy Policy</a>.</p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </AnimatedSection>

  <section class="relative border-t border-white/5">
    <div class="h-[400px] w-full bg-neutral-900 overflow-hidden">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3799.999!2d31.0335!3d-17.8252!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTfCsDQ5JzMwLjciUyAzMcKwMDInMDAuNyJF!5e0!3m2!1sen!2szw!4v1" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Classic Reinsurance Brokers office location"></iframe>
    </div>
  </section>
</AppLayout>
