---
import AppLayout from '../../../components/layouts/AppLayout.astro';
import Breadcrumb from '../../../components/astro/Breadcrumb.astro';
import AnimatedSection from '../../../components/react/AnimatedSection.tsx';
import { products, type Product } from '../../../data/products';
import { site } from '../../../data/site';
import { productSlugs } from '../../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props as { product: Product };
const productName = product.name;
const slug = product.slug;
const imagePath = `/images/hero-${slug}.png`;
const imageFallback = `/images/serviceshero.png`;
const allProducts = productSlugs;

const contentImgs: Record<string, string[]> = {
  'motor-insurance': ['/images/products/motorinsuranceHero.png', '/images/products/motorefeaturesection.png'],
  'household': ['/images/products/HouseholdAbout.jpg', '/images/products/HouseholdCallTo.jpg'],
  'engineering': ['/images/products/engineeringAbout.jpg', '/images/products/engineeringCallTo.jpg'],
  'assets-all-risks': ['/images/products/AssetAllRisk1.jpg', '/images/products/AssetAllRisk2.jpg'],
  'liability-insurance': ['/images/products/LiabilityAbout.png', '/images/products/LiabilityAbout2.png'],
  'group-personal-accidents': ['/images/products/groupaccident1.jpg', '/images/products/manufacturinggpa.jpg', '/images/products/mininggpa.jpg'],
  'travel-insurance': ['/images/products/travelHero.png'],
  'goods-in-transit': ['/images/products/gitabout.png', '/images/products/retailgit.png', '/images/products/manufacturinggit.png'],
  'agriculture-insurance': ['/images/products/AgricultureAbout.png', '/images/products/AgricultureHero.png'],
};
const pageImages = contentImgs[slug] || [];
const productImg = (idx: number, fallback: string) => idx < pageImages.length ? pageImages[idx] : fallback;
---

<AppLayout
  title={`${productName} Reinsurance — Zimbabwe`}
  description={product.subtitle}
  keywords={`${slug} reinsurance Zimbabwe, ${productName} reinsurance Zimbabwe, ${productName} treaty, ${productName} facultative, insurance companies Zimbabwe, reinsurance intermediary, reinsurance broker Harare, ${productName} insurance Zimbabwe, broking companies Zimbabwe, reinsurance companies Zimbabwe`}
  ogTitle={`${productName} Reinsurance | Classic Reinsurance Brokers — Zimbabwe`}
  ogDescription={product.subtitle}
  canonical={`https://www.classicre.co.zw/services/product/${slug}`}
  productJsonLd={`{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "${productName} Reinsurance - Classic Reinsurance Brokers",
    "description": "${product.description.replace(/"/g, '\\"')}",
    "provider": {
      "@type": "InsuranceBrokerage",
      "name": "Classic Reinsurance Brokers",
      "url": "https://www.classicre.co.zw",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "11th Floor Fidelity Life Tower, 5 Raleigh Street",
        "addressLocality": "Harare",
        "addressCountry": "ZW"
      }
    },
    "areaServed": ["Zimbabwe", "Harare", "Bulawayo", "Mutare", "Gweru", "Africa"]
  }`}
  faqJsonLd={`{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is ${productName} reinsurance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "${product.fullDescription.substring(0, 200).replace(/"/g, '\\"')}"
        }
      },
      {
        "@type": "Question",
        "name": "How can insurance companies in Zimbabwe access ${productName} reinsurance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Insurance companies in Zimbabwe can access ${productName} reinsurance through Classic Reinsurance Brokers, a licensed IPEC-regulated reinsurance broker based in Harare. Contact us at +263 242 773192 or info@classicre.co.zw for a confidential consultation."
        }
      },
      {
        "@type": "Question",
        "name": "What are the benefits of ${productName} reinsurance for insurers?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Benefits include access to leading global and regional reinsurance capacity, tailored treaty and facultative structures, claims advocacy and recovery support, regular market updates, and a dedicated broking team with deep ${productName} reinsurance expertise."
        }
      }
    ]
  }`}
  breadcrumbJsonLd={`{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.classicre.co.zw" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.classicre.co.zw/services" },
      { "@type": "ListItem", "position": 3, "name": "${productName}", "item": "https://www.classicre.co.zw/services/product/${slug}" }
    ]
  }`}
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: productName }]} />

  <section class="relative min-h-[55vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src={imagePath} alt="" class="h-full w-full object-cover" onerror={`this.onerror=null;this.src='${imageFallback}'`} />
      <div class="absolute inset-0 bg-gradient-to-br from-primary-900/80 via-neutral-950/85 to-neutral-950"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8 py-24 lg:py-32 w-full">
      <div class="max-w-3xl">
        <span class="fade-up inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold text-primary-200">{productName} Reinsurance</span>
        <h1 class="fade-up mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl" style="transition-delay: 0.1s">{productName}</h1>
        <p class="fade-up mt-6 max-w-xl text-lg leading-relaxed text-neutral-300" style="transition-delay: 0.2s">{product.subtitle}</p>
        <div class="fade-up mt-8 flex flex-wrap gap-4" style="transition-delay: 0.3s">
          <a href="/contact" class="btn bg-white text-primary-700 hover:bg-primary-50">Get a quote</a>
          <a href="/services" class="btn border border-white/30 text-white hover:bg-white/10">All products</a>
        </div>
      </div>
    </div>
  </section>

  {product.fullDescription && (
    <AnimatedSection animation="fade-up">
      <section class="py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-5">
            <div class="lg:col-span-3">
              <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">Overview</span>
              <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl font-sora">About this product</h2>
              <p class="mt-6 text-lg leading-relaxed text-neutral-300">{product.fullDescription}</p>
              <div class="mt-6 rounded-xl border border-primary-500/20 bg-primary-500/5 p-4">
                <p class="text-sm text-primary-200">As a specialist <strong class="text-white">reinsurance broker</strong>, we connect insurance companies with leading global and regional reinsurance markets. We do not underwrite risk or assume liability directly. We facilitate the placement of risk with leading reinsurers, giving our clients access to the capacity, expertise, and terms they need to serve their policyholders with confidence.</p>
              </div>
            </div>
            <div class="lg:col-span-2 space-y-6" style="transition-delay:0.1s">
              <h3 class="text-xl font-bold text-white">At a glance</h3>
              <ul class="space-y-4">
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Reinsurance product</strong><br />Treaty and facultative support</span></li>
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Coverage area</strong><br />Zimbabwe and select African markets</span></li>
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Market access</strong><br />Global and regional reinsurer panel</span></li>
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Service model</strong><br />End-to-end broking and claims advocacy</span></li>
              </ul>
              {pageImages.length > 0 && (
                <div class="overflow-hidden rounded-xl">
                  <img src={productImg(0, imagePath)} alt="" class="h-48 w-full object-cover" />
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {product.features.length > 0 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="max-w-2xl mx-auto text-center">
            <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">What we cover</span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-sora">Key coverage areas</h2>
            <p class="mt-4 text-lg text-neutral-400">Comprehensive {productName} reinsurance solutions designed for the Zimbabwean market.</p>
          </div>
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {product.features.map((feature, i) => {
              const parts = feature.split(' — ');
              const featName = parts[0];
              const featDesc = parts.length > 1 ? parts.slice(1).join(' — ') : '';
              return (
                <div class="fade-up rounded-xl border border-white/10 bg-white/5 relative overflow-hidden p-6 group" style={`transition-delay: ${i * 0.05}s`}>
                  <div class="absolute right-0 top-0 h-20 w-20 translate-x-8 -translate-y-8 rounded-full bg-primary-600/5 transition-all group-hover:scale-150"></div>
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-600/10 text-primary-400 transition-colors group-hover:bg-primary-600 group-hover:text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  </div>
                  <h3 class="mt-4 text-lg font-bold text-white">{featName}</h3>
                  {featDesc && <p class="mt-2 text-sm leading-relaxed text-neutral-400">{featDesc}</p>}
                </div>
              );
            })}
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {product.benefits.length > 0 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 bg-neutral-900/50 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-2">
            <div>
              <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">Client benefits</span>
              <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl font-sora">Why choose our {productName} solutions</h2>
              <p class="mt-6 text-lg leading-relaxed text-neutral-400">When you partner with Classic Reinsurance Brokers for your {productName.toLowerCase()} reinsurance, you gain access to market-leading expertise, capacity, and service delivery.</p>
              {pageImages.length > 1 && (
                <div class="mt-8 overflow-hidden rounded-xl">
                  <img src={productImg(1, imagePath)} alt="" class="h-56 w-full object-cover" />
                </div>
              )}
            </div>
            <div class="space-y-4" style="transition-delay:0.1s">
              {product.benefits.map((benefit, i) => (
                <div class="rounded-xl border border-white/10 bg-white/5 flex items-start gap-4 p-5 transition-all hover:border-primary-500/30">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400 text-sm font-bold">{i + 1}</span>
                  <div>
                    <p class="text-base font-semibold text-white">{benefit}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {product.process.length > 0 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="max-w-2xl mx-auto text-center">
            <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">How we work</span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-sora">Our approach</h2>
            <p class="mt-4 text-lg text-neutral-400">A structured process from risk assessment through to ongoing programme management.</p>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {product.process.map((step, i) => (
              <div class="fade-up relative text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-primary-600 to-primary-800 text-white text-xl font-bold shadow-lg shadow-primary-600/20">{i + 1}</div>
                {i < product.process.length - 1 && <div class="absolute left-[calc(50%+40px)] top-8 hidden h-0.5 w-[calc(100%-80px)] bg-gradient-to-r from-primary-500/50 to-transparent lg:block"></div>}
                <h3 class="mt-5 text-base font-bold text-white">{step}</h3>
                <p class="mt-2 text-xs text-neutral-400">Dedicated support throughout every stage of the reinsurance lifecycle.</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {pageImages.length > 2 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="overflow-hidden rounded-2xl">
            <img src={productImg(2, imagePath)} alt="" class="h-72 w-full object-cover" />
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  <AnimatedSection animation="fade-up">
    <section class="border-t border-white/10 py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">Why choose us</span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl font-sora">Why Classic Reinsurance Brokers</h2>
            <p class="mt-6 text-lg leading-relaxed text-neutral-400">With decades of combined experience in the African reinsurance market, we bring unparalleled expertise, strong carrier relationships, and a client-first approach to every placement.</p>
            <div class="mt-10 grid gap-6 sm:grid-cols-2">
              <div class="rounded-xl border border-white/10 bg-white/5 flex gap-4 p-5 transition-all hover:border-primary-500/30">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-600/10 text-primary-400"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747"/></svg></div>
                <div><h3 class="text-sm font-bold text-white">Deep Market Knowledge</h3><p class="mt-1 text-xs text-neutral-400">Intimate understanding of local regulations, risks, and market dynamics across Africa.</p></div>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/5 flex gap-4 p-5 transition-all hover:border-primary-500/30">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-600/10 text-primary-400"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 003.741-.479"/></svg></div>
                <div><h3 class="text-sm font-bold text-white">Strong Carrier Relationships</h3><p class="mt-1 text-xs text-neutral-400">Access to leading global and regional reinsurers ensuring competitive terms and security.</p></div>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/5 flex gap-4 p-5 transition-all hover:border-primary-500/30">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-600/10 text-primary-400"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg></div>
                <div><h3 class="text-sm font-bold text-white">Tailored Solutions</h3><p class="mt-1 text-xs text-neutral-400">Customised reinsurance programmes designed around your specific risk profile and needs.</p></div>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/5 flex gap-4 p-5 transition-all hover:border-primary-500/30">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-600/10 text-primary-400"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0"/></svg></div>
                <div><h3 class="text-sm font-bold text-white">End-to-End Support</h3><p class="mt-1 text-xs text-neutral-400">Dedicated broking team guiding you from programme design through to claims advocacy.</p></div>
              </div>
            </div>
          </div>
          <aside class="lg:col-span-1">
            <div class="sticky top-24 rounded-xl border border-white/10 bg-white/5 p-6">
              <h3 class="text-base font-bold text-white">Reinsurance Products</h3>
              <p class="mt-1 text-xs text-neutral-400">Explore our full range of reinsurance solutions.</p>
              <ul class="mt-6 space-y-1">
                {Object.entries(allProducts).map(([slug, name]) => (
                  <li>
                    <a href={`/services/product/${slug}`} class={`flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition-all hover:bg-primary-600/10 hover:text-primary-300 ${name === productName ? 'bg-primary-600/10 text-primary-300' : 'text-neutral-400'}`}>
                      <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                      {name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </AnimatedSection>

  <AnimatedSection animation="fade-up">
    <section class="relative overflow-hidden border-t border-white/10 py-20 lg:py-28">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-900/60 via-neutral-950/90 to-neutral-950"></div>
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/3 left-1/4 h-2 w-2 rounded-full bg-primary-500/30 animate-pulse" style="animation-delay: 0s"></div>
        <div class="absolute bottom-1/4 right-1/3 h-2.5 w-2.5 rounded-full bg-primary-400/20 animate-pulse" style="animation-delay: 1.5s"></div>
        <div class="absolute top-1/2 right-1/4 h-1.5 w-1.5 rounded-full bg-white/10 animate-pulse" style="animation-delay: 3s"></div>
      </div>
      <div class="relative z-10 mx-auto max-w-3xl px-6 text-center lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-sora">Partner with Classic Reinsurance Brokers</h2>
        <p class="mt-6 text-lg leading-relaxed text-primary-200">Let our team of experienced reinsurance brokers help you structure the optimal programme for {productName}. Contact us today for a confidential discussion.</p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a href="/contact" class="btn bg-primary-600 text-white hover:bg-primary-700 text-base px-8 py-3">Request a consultation</a>
          <a href="tel:{site.phoneRaw}" class="btn border border-white/30 text-white hover:bg-white/10 text-base px-8 py-3">{site.phone}</a>
        </div>
      </div>
    </section>
  </AnimatedSection>
</AppLayout>
