---
import AppLayout from '../../../components/layouts/AppLayout.astro';
import Breadcrumb from '../../../components/astro/Breadcrumb.astro';
import AnimatedSection from '../../../components/react/AnimatedSection.tsx';
import { specialties, type Specialty } from '../../../data/specialties';
import { site } from '../../../data/site';
import { specialtySlugs } from '../../../data/site';

export function getStaticPaths() {
  return specialties.map((s) => ({
    params: { slug: s.slug },
    props: { specialty: s },
  }));
}

const { specialty } = Astro.props as { specialty: Specialty };
const name = specialty.name;
const slug = specialty.slug;
const imagePath = `/images/specialty/${slug}.jpg`;
const imagePng = `/images/specialty/${slug}.png`;
const imageFallback = `/images/specialty/${slug}-insurance.jpg`;
const imagePngFallback = `/images/specialty/${slug}-insurance.png`;
const heroImagePath = `/images/specialty/hero-${slug}.png`;
const heroImageJpg = `/images/specialty/hero-${slug}.jpg`;
const heroFallback = `/images/serviceshero.png`;
const allSpecialties = specialtySlugs;

const contentImgs: Record<string, string[]> = {
  'aviation': ['/images/specialty/aviation1.jpg', '/images/specialty/aviation2.jpg'],
  'bankers-blanket': ['/images/specialty/bankersblanket1.png', '/images/specialty/bankersblanket2.png'],
  'construction-projects': ['/images/specialty/constructionProject1.png', '/images/specialty/constructionProject2.png'],
  'cyber': ['/images/specialty/cyber1.jpg', '/images/specialty/cyber2.jpg'],
  'kidnap-and-ransom': ['/images/specialty/randk1.png', '/images/specialty/randk2.png'],
  'marine-hull': ['/images/specialty/marine-hull-insurance.jpg'],
  'power-projects': ['/images/specialty/projectpower1.png', '/images/specialty/projectpower2.png'],
  'political-risks': ['/images/specialty/political1.png', '/images/specialty/political2.png'],
  'political-violence-terrorism': ['/images/specialty/political1.png', '/images/specialty/political2.png'],
};
const pageImages = contentImgs[slug] || [];
const specImg = (idx: number, fallback: string) => idx < pageImages.length ? pageImages[idx] : fallback;
---

<AppLayout
  title={`${name} Specialty Reinsurance`}
  description={specialty.description}
  keywords={`${slug} specialty reinsurance, ${name} insurance Zimbabwe, specialty risk insurance, complex risk reinsurance, emerging risk coverage Zimbabwe`}
  ogTitle={`${name} Specialty Reinsurance | Classic Reinsurance Brokers`}
  ogDescription={specialty.description}
  canonical={`https://www.classicre.co.zw/services/specialty/${slug}`}
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: name }]} />

  <section class="relative min-h-[55vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src={heroImagePath} alt="" class="h-full w-full object-cover" onerror={`this.onerror=null;this.src='${heroImageJpg}'`} />
      <div class="absolute inset-0 bg-gradient-to-br from-primary-900/80 via-neutral-950/85 to-neutral-950"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8 py-24 lg:py-32 w-full">
      <div class="max-w-3xl">
        <span class="fade-up inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold text-primary-200">Specialty risk</span>
        <h1 class="fade-up mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl" style="transition-delay: 0.1s">{name}</h1>
        <p class="fade-up mt-6 max-w-xl text-lg leading-relaxed text-neutral-300" style="transition-delay: 0.2s">{specialty.description}</p>
        <div class="fade-up mt-8 flex flex-wrap gap-4" style="transition-delay: 0.3s">
          <a href="/contact" class="btn bg-white text-primary-700 hover:bg-primary-50">Discuss your risk</a>
          <a href="/services" class="btn border border-white/30 text-white hover:bg-white/10">All specialties</a>
        </div>
      </div>
    </div>
  </section>

  {specialty.fullDescription && (
    <AnimatedSection animation="fade-up">
      <section class="py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-5">
            <div class="lg:col-span-3">
              <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">About this specialty</span>
              <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl font-sora">{name} Reinsurance</h2>
              <p class="mt-6 text-lg leading-relaxed text-neutral-300">{specialty.fullDescription}</p>
              <div class="mt-6 rounded-xl border border-primary-500/20 bg-primary-500/5 p-4">
                <p class="text-sm text-primary-200">As a specialist <strong class="text-white">reinsurance broker</strong>, we connect insurance companies with leading global and regional specialty reinsurance markets. We do not underwrite risk or assume liability directly. We facilitate the placement of complex and emerging risks with leading global specialty markets.</p>
              </div>
            </div>
            <div class="lg:col-span-2 space-y-6" style="transition-delay:0.1s">
              <h3 class="text-xl font-bold text-white">At a glance</h3>
              <ul class="space-y-4">
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Specialty class</strong><br />Facultative and treaty support</span></li>
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Coverage area</strong><br />Zimbabwe, Africa, and select global markets</span></li>
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Market access</strong><br />Lloyd's, London market, international specialty</span></li>
                <li class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/></svg></span><span class="text-sm text-neutral-400"><strong class="text-neutral-200">Service model</strong><br />Dedicated specialty broker support</span></li>
              </ul>
              {pageImages.length > 0 && (
                <div class="overflow-hidden rounded-xl">
                  <img src={specImg(0, heroImagePath)} alt="" class="h-48 w-full object-cover" />
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {specialty.features.length > 0 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="max-w-2xl mx-auto text-center">
            <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">Service details</span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-sora">Coverage options</h2>
            <p class="mt-4 text-lg text-neutral-400">Specialist reinsurance capacity designed for {name.toLowerCase()} risks.</p>
          </div>
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {specialty.features.map((feature, i) => {
              const parts = feature.split(' — ');
              const featName = parts[0];
              const featDesc = parts.length > 1 ? parts.slice(1).join(' — ') : '';
              return (
                <div class="fade-up rounded-xl border border-white/10 bg-white/5 relative overflow-hidden p-6 group" style={`transition-delay: ${i * 0.05}s`}>
                  <div class="absolute right-0 top-0 h-20 w-20 translate-x-8 -translate-y-8 rounded-full bg-primary-600/5 transition-all group-hover:scale-150"></div>
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-600/10 text-primary-400 transition-colors group-hover:bg-primary-600 group-hover:text-white">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  </div>
                  <h3 class="mt-4 text-lg font-bold text-white">{featName}</h3>
                  {featDesc && <p class="mt-2 text-sm leading-relaxed text-neutral-400">{featDesc}</p>}
                </div>
              );
            })}
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {specialty.benefits.length > 0 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 bg-neutral-900/50 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-2">
            <div>
              <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">Client benefits</span>
              <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl font-sora">Why our {name} solutions</h2>
              <p class="mt-6 text-lg leading-relaxed text-neutral-400">Partner with Classic Reinsurance Brokers for your {name.toLowerCase()} reinsurance needs and gain access to specialist expertise, global capacity, and dedicated service.</p>
              {pageImages.length > 1 && (
                <div class="mt-8 overflow-hidden rounded-xl">
                  <img src={specImg(1, heroImagePath)} alt="" class="h-56 w-full object-cover" />
                </div>
              )}
            </div>
            <div class="space-y-4" style="transition-delay:0.1s">
              {specialty.benefits.map((benefit, i) => (
                <div class="rounded-xl border border-white/10 bg-white/5 flex items-start gap-4 p-5 transition-all hover:border-primary-500/30">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-primary-400 text-sm font-bold">{i + 1}</span>
                  <div>
                    <p class="text-base font-semibold text-white">{benefit}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {specialty.process.length > 0 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="max-w-2xl mx-auto text-center">
            <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">How we work</span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-sora">Our approach</h2>
            <p class="mt-4 text-lg text-neutral-400">A structured process from risk assessment through to ongoing programme management.</p>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {specialty.process.map((step, i) => (
              <div class="fade-up relative text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-primary-600 to-primary-800 text-white text-xl font-bold shadow-lg shadow-primary-600/20">{i + 1}</div>
                {i < specialty.process.length - 1 && <div class="absolute left-[calc(50%+40px)] top-8 hidden h-0.5 w-[calc(100%-80px)] bg-gradient-to-r from-primary-500/50 to-transparent lg:block"></div>}
                <h3 class="mt-5 text-base font-bold text-white">{step}</h3>
                <p class="mt-2 text-xs text-neutral-400">Dedicated support throughout every stage of the specialty reinsurance lifecycle.</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  {pageImages.length > 2 && (
    <AnimatedSection animation="fade-up">
      <section class="border-t border-white/10 py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="overflow-hidden rounded-2xl">
            <img src={specImg(2, heroImagePath)} alt="" class="h-72 w-full object-cover" />
          </div>
        </div>
      </section>
    </AnimatedSection>
  )}

  <AnimatedSection animation="fade-up">
    <section class="border-t border-white/10 py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <div class="max-w-2xl">
              <span class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-xs font-semibold text-primary-400 border border-primary-500/20">Why partner with us</span>
              <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-sora">Why partner with us</h2>
              <p class="mt-4 text-lg text-neutral-400">What makes Classic Reinsurance Brokers the right partner for your specialty reinsurance needs.</p>
            </div>
            <div class="mt-12 grid gap-6 sm:grid-cols-2">
              <div class="fade-up rounded-xl border border-white/10 bg-white/5 p-6 text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-600/10 text-primary-400"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 9.75l-4.5 4.5L9 12"/></svg></div>
                <h3 class="mt-4 text-base font-bold text-white">Specialist Expertise</h3>
                <p class="mt-2 text-sm text-neutral-400">Deep technical knowledge across complex and emerging risk classes with proven placement track records.</p>
              </div>
              <div class="fade-up rounded-xl border border-white/10 bg-white/5 p-6 text-center" style="transition-delay: 0.1s">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-600/10 text-primary-400"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747"/></svg></div>
                <h3 class="mt-4 text-base font-bold text-white">Global Market Access</h3>
                <p class="mt-2 text-sm text-neutral-400">Direct relationships with Lloyd's, London company market, and international specialty reinsurers.</p>
              </div>
              <div class="fade-up rounded-xl border border-white/10 bg-white/5 p-6 text-center" style="transition-delay: 0.2s">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-600/10 text-primary-400"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751"/></svg></div>
                <h3 class="mt-4 text-base font-bold text-white">Technical Underwriting</h3>
                <p class="mt-2 text-sm text-neutral-400">Rigorous risk assessment and programme structuring backed by deep actuarial and underwriting capability.</p>
              </div>
              <div class="fade-up rounded-xl border border-white/10 bg-white/5 p-6 text-center" style="transition-delay: 0.3s">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-600/10 text-primary-400"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3"/></svg></div>
                <h3 class="mt-4 text-base font-bold text-white">Dedicated Service</h3>
                <p class="mt-2 text-sm text-neutral-400">Responsive, client-dedicated teams providing continuity and deep understanding of your business.</p>
              </div>
            </div>
          </div>
          <aside class="lg:col-span-1">
            <div class="sticky top-24 rounded-xl border border-white/10 bg-white/5 p-6">
              <h3 class="text-base font-bold text-white">Specialty Risk Classes</h3>
              <p class="mt-1 text-xs text-neutral-400">Explore our full range of specialty insurance solutions.</p>
              <ul class="mt-6 space-y-1">
                {Object.entries(allSpecialties).map(([slug, sname]) => (
                  <li>
                    <a href={`/services/specialty/${slug}`} class={`flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition-all hover:bg-primary-600/10 hover:text-primary-300 ${sname === name ? 'bg-primary-600/10 text-primary-300' : 'text-neutral-400'}`}>
                      <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                      {sname}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </AnimatedSection>

  <AnimatedSection animation="fade-up">
    <section class="relative overflow-hidden border-t border-white/10 py-20 lg:py-28">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-900/60 via-neutral-950/90 to-neutral-950"></div>
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/3 left-1/4 h-2 w-2 rounded-full bg-primary-500/30 animate-pulse" style="animation-delay: 0s"></div>
        <div class="absolute bottom-1/4 right-1/3 h-2.5 w-2.5 rounded-full bg-primary-400/20 animate-pulse" style="animation-delay: 1.5s"></div>
      </div>
      <div class="relative z-10 mx-auto max-w-3xl px-6 text-center lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-sora">Partner with Classic Reinsurance Brokers</h2>
        <p class="mt-6 text-lg leading-relaxed text-primary-200">Our specialty team is ready to help you navigate complex risks with bespoke reinsurance solutions. Contact us to discuss how we can support your unique requirements.</p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a href="/contact" class="btn bg-primary-600 text-white hover:bg-primary-700 text-base px-8 py-3">Contact our team</a>
          <a href="tel:{site.phoneRaw}" class="btn border border-white/30 text-white hover:bg-white/10 text-base px-8 py-3">{site.phone}</a>
        </div>
      </div>
    </section>
  </AnimatedSection>
</AppLayout>
